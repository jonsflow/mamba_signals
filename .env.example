# System type configuration
# Set SYSTEM_TYPE to determine which config to load
# - "dev": Uses config.py (Mac-optimized, small batch sizes)
# - "gpu": Uses gpu_config.py (NVIDIA GPU-optimized, large batch sizes)

SYSTEM_TYPE=dev

# Copy this file to .env and edit the value:
#   cp .env.example .env
#   # Edit .env and set SYSTEM_TYPE=gpu or SYSTEM_TYPE=dev
#
# Then run:
#   python3 train.py
#
# The config will be loaded automatically based on SYSTEM_TYPE.
